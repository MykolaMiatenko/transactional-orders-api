{
  "openapi": "3.0.3",
  "info": {
    "title": "Transactional Order API",
    "version": "2.0.0",
    "description": "JWT authentication, scoped authorization, concurrent inventory reservations, idempotent creation, cursor pagination and transactional cancellation. Outbox delivery is at least once."
