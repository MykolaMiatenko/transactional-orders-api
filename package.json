{
  "name": "transactional-order-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Transactional order API with PostgreSQL and idempotency",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "token:dev": "tsx scripts/token.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "worker:dev": "tsx src/worker.ts",
    "consumer:dev": "tsx src/consumer.ts",
    "worker": "node dist/src/worker.js",
    "consumer": "node dist/src/consumer.js"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "pino": "^9.9.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
