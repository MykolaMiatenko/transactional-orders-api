NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://orders:orders@localhost:5432/orders
DB_POOL_MAX=10
LOG_LEVEL=info
# Replace this local-only secret before deployment; use at least 32 bytes.
JWT_SECRET=local-development-secret-change-me-32-bytes-minimum
JWT_ISSUER=order-api
JWT_AUDIENCE=order-api-clients
JWT_MODE=HS256
# For RS256, set a trusted HTTPS endpoint and matching issuer/audience.
# JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
JWKS_TIMEOUT_MS=3000
JWKS_COOLDOWN_MS=30000
JWKS_CACHE_MAX_AGE_MS=600000
AMQP_URL=amqp://orders:orders@localhost:5672
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_MS=1000
AMQP_CONFIRM_TIMEOUT_MS=5000
CONSUMER_MAX_ATTEMPTS=5
